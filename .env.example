# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook Secret Token for verification
TELEGRAM_SECRET_TOKEN=your_secret_token_here

# Obsidian Vault Git Repository
GIT_REPO_URL=git@github.com:yourusername/your-obsidian-vault.git
GIT_BRANCH=main
SSH_KEY_PATH=./secrets/pkm_deploy_key

# Local Vault Path (e.g., ./vault or ./vault_data for local development)
VAULT_PATH=./vault_data

# Qdrant Vector Store Configuration
# Embedded mode (default, zero Docker dependency):
QDRANT_STORAGE_PATH=./qdrant_storage

# QDRANT_STORAGE_PATH=
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Security Whitelist: Comma-separated list of authorized Telegram user/chat IDs
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Optional LLM & Embeddings Configuration
# AGY_PATH=/usr/local/bin/agy
# LLM_MODEL=flash
# LLM_EFFORT=medium
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# QDRANT_COLLECTION_NAME=pkm_notes

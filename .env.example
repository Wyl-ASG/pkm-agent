# Telegram Bot API Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook Secret Token for verification
TELEGRAM_SECRET_TOKEN=your_secret_token_here

# Obsidian Vault Git Repository
GIT_REPO_URL=git@github.com:yourusername/your-obsidian-vault.git
GIT_BRANCH=main
SSH_KEY_PATH=./secrets/pkm_deploy_key
# Minutes between retries of vault pushes that failed (0 disables). Failures are reported on Telegram.
# GIT_SYNC_INTERVAL_MINUTES=15

# Local Vault Path (e.g., ./vault or ./vault_data for local development)
VAULT_PATH=./vault_data

# Qdrant Vector Store Configuration
# Embedded mode (default, zero Docker dependency):
QDRANT_STORAGE_PATH=./qdrant_storage

# QDRANT_STORAGE_PATH=
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Security Whitelist: Comma-separated list of authorized Telegram user/chat IDs
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# LLM via OpenRouter (key from https://openrouter.ai/keys)
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_FALLBACK_MODELS=xingchen-agi/xing4.0-29b-a4b:free,dots-studio/dots-3-note-preview:free
# 'deny' only uses providers that do not store or train on your prompts; requests fail rather than leak.
# OPENROUTER_DATA_COLLECTION=deny
# OPENROUTER_REASONING=false

# Optional LLM & Embeddings Configuration
# AGY_PATH=/usr/local/bin/agy
# LLM_MODEL=flash
# LLM_EFFORT=medium
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_THINK=false
# OLLAMA_TEMPERATURE=0
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# QDRANT_COLLECTION_NAME=pkm_notes
